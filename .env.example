# Backend
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
QUOTE_CACHE_SECONDS=30
STALE_QUOTE_SECONDS=180
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3

# Authentication
AUTH_DATABASE_PATH=./data/auth.db
AUTH_SESSION_SECONDS=604800

# Twelve Data - backend only
# Set the real value in the deployment secret/environment settings.
TWELVE_DATA_API_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_QUOTE_REFRESH_SECONDS=60
